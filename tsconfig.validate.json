{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": ".validation-build",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "isolatedModules": false,
    "plugins": []
  },
  "include": [
    "scripts/validate-products.ts",
    "scripts/validate-product-filtering.ts",
    "src/lib/categories.ts",
    "src/lib/catalog-overrides.ts",
    "src/lib/catBreeds.ts",
    "src/lib/products.ts",
    "src/lib/searchProducts.ts",
    "src/lib/order.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".validation-build"
  ]
}
