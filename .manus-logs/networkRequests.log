arent_category\":\"cats\",\"slug\":\"wet-cans\",\"status\":\"active\",\"subCategory\":\"wet-cans\",\"sub_category\":\"wet-cans\",\"subcategory\":\"wet-cans\",\"subcategory_slug\":\"wet-cans\",\"tag\":\"貓咪商品\",\"type\":\"wet-cans\"}},{\"id\":\"prod_V5Cy07SyT7B6gF\",\"name\":\"CIAO 貓罐罐 - 白肉金槍魚、鰹魚乾 85g  x 6個\",\"description\":\"經典白肉金槍魚罐底，點綴香醇鰹魚乾，是 CIAO 最耐看的日常味道。湯汁清亮、肉質細緻，適合當作每週濕食輪替的主力款。綠茶消臭成分照顧家居氣味，讓開罐時刻既幸福、也安心。\",\"image\":null,\"images\":[],\"priceId\":\"price_1U52Y8RyM6dRKLtZwpSBdLy9\",\"unitAmount\":7800,\"currency\":\"hkd\",\"active\":true,\"metadata\":{\"Categories\":\"貓咪商品\",\"Category\":\"貓咪商品\",\"Parent_Category\":\"貓咪商品\",\"SubCategory\":\"貓罐頭\",\"category\":\"cats\",\"category_slug\":\"cats\",\"child_category\":\"wet-cans\",\"id\":\"wt-product-10\",\"is_active\":\"true\",\"parent_category\":\"cats\",\"slug\":\"wet-cans\",\"status\":\"active\",\"subCategory\":\"wet-cans\",\"sub_category\":\"wet-cans\",\"subcategory\":\"wet-cans\",\"subcategory_alt\":\"罐罐 / 濕糧\",\"subcategory_slug\":\"wet-cans\",\"tag\":\"貓咪商品\",\"tags\":\"貓咪商品\",\"type\":\"wet-cans\"}},{\"id\":\"prod_V5Cy3t0lLGQBH1\",\"name\":\"CIAO 貓罐罐 - 白肉金槍魚、越光米 85g  x 6個\",\"description\":\"柔滑白肉金槍魚遇見日本越光米的溫潤口感，質地綿密、好吞嚥，適合需要溫和腸胃體驗或偏好軟食的貓咪。魚肉提供優質蛋白，米粒增添飽足層次，是節奏較慢、愛慢慢品嚐的毛孩的安心選擇。\",\"image\":null,\"images\":[],\"priceId\":\"price_1U52Y7RyM6dRKLtZYlnwdHlL\",\"unitAmount\":7800,\"currency\":\"hkd\",\"active\":true,\"metadata\":{\"Categories\":\"貓咪商品\",\"Category\":\"貓咪商品\",\"Parent_Category\":\"貓咪商品\",\"SubCategory\":\"貓罐頭\",\"category\":\"cats\",\"category_slug\":\"cats\",\"child_category\":\"wet-cans\",\"id\":\"wt-product-9\",\"is_active\":\"true\",\"parent_category\":\"cats\",\"slug\":\"wet-cans\",\"status\":\"active\",\"subCategory\":\"wet-cans\",\"sub_category\":\"wet-cans\",\"subcategory\":\"wet-cans\",\"subcategory_alt\":\"罐罐 / 濕糧\",\"subcategory_slug\":\"wet-cans\",\"tag\":\"貓咪商品\",\"tags\":\"貓咪商品\",\"type\":\"wet-cans\"}},{\"id\":\"prod_V5Cy3j6T15p2xK\",\"name\":\"CIAO 貓罐罐 - 雞肉, 黃金槍魚, 木魚乾 85g x6個\",\"description\":\"雞肉基底搭配黃金槍魚，再撒上香氣濃郁的木魚乾，打開罐蓋即是滿滿日式高湯氣息。層次分明的鮮味特別適合嗅覺靈敏、愛「聞香下飯」的活躍貓。可單獨享用，亦可淋在乾糧上瞬間升級成豪華濕食餐。\",\"image\":null,\"images\":[],\"priceId\":\"price_1U52Y7RyM6dRKLtZAo48GaSj\",\"unitAmount\":7800,\"currency\":\"hkd\",\"active\":true,\"metadata\":{\"Categories\":\"貓咪商品\",\"Category\":\"貓咪商品\",\"Parent_Category\":\"貓咪商品\",\"SubCategory\":\"貓罐頭\",\"category\":\"cats\",\"category_slug\":\"cats\",\"child_category\":\"wet-cans\",\"id\":\"wt-product-8\",\"is_active\":\"true\",\"parent_category\":\"cats\",\"slug\":\"wet-cans\",\"status\":\"active\",\"subCategory\":\"wet-cans\",\"sub_category\":\"wet-cans\",\"subcategory\":\"wet-cans\",\"subcategory_alt\":\"罐罐 / 濕糧\",\"subcategory_slug\":\"wet-cans\",\"tag\":\"貓咪商品\",\"tags\":\"貓咪商品\",\"type\":\"wet-cans\"}},{\"id\":\"prod_V5CyQM7pK1fhmc\",\"name\":\"CIAO 貓罐罐 - 白肉金槍魚, 白飯魚85g x6個\",\"description\":\"細嫩白肉金槍魚綴上晶瑩白飯魚，視覺與口感同樣討喜。小魚乾帶來輕脆咬感，刺激好奇心旺盛的貓貓主動進食。湯汁充足、氣味清新，無論家中唐貓或小型品種，都是一罐就能提升幸福感的日常罐罐。\",\"image\":null,\"images\":[],\"priceId\":\"price_1U52Y6RyM6dRKLtZe1TrFStL\",\"unitAmount\":7800,\"currency\":\"hkd\",\"active\":true,\"metadata\":{\"Categories\":\"貓咪商品\",\"Category\":\"貓咪商品\",\"Parent_Category\":\"貓咪商品\",\"SubCategory\":\"貓罐頭\",\"category\":\"cats\",\"category_slug\":\"cats\",\"child_category\":\"wet-cans\",\"id\":\"wt-product-7\",\"is_active\":\"true\",\"parent_category\":\"cats\",\"slug\":\"wet-cans\",\"status\":\"active\",\"subCategory\":\"wet-cans\",\"sub_category\":\"wet-cans\",\"subcategory\":\"wet-cans\",\"subcategory_alt\":\"罐罐 / 濕糧\",\"subcategory_slug\":\"wet-cans\",\"tag\":\"貓咪商品\",\"tags\":\"貓咪商品\",\"type\":\"wet-cans\"}},{\"id\":\"prod_V5CyvBfvqnj5BN\",\"name\":\"CIAO 貓罐罐 - 雞胸肉 鯛魚 鯛魚汁 85g x6個\",\"description\":\"低脂雞胸肉與日系鯛魚相遇，再浸入清甜鯛魚汁，口感清雅、負擔較輕。適合偏好清淡海鮮、或需要溫和蛋白輪替的貓咪。細緻肉塊搭配豐盈湯汁，日常補水與換口味都能優雅完成。\",\"image\":null,\"images\":[],\"priceId\":\"price_1U52Y6RyM6dRKLtZ8ZyWvTeS\",\"unitAmount\":7800,\"currency\":\"hkd\",\"active\":true,\"metadata\":{\"Categories\":\"貓咪商品\",\"Category\":\"貓咪商品\",\"Parent_Category\"