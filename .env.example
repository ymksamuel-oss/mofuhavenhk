# Site
NEXT_PUBLIC_SITE_URL=https://mofuhavenhk.com

# =============================================================================
# Google Sheet single-source product catalog fields (server-only, read-only)
#
# The parser scans the first 20 non-empty rows, so row 1 may be a title.
# Required field groups include:
# id / 商品 ID
# image / 本地圖片路徑 / 來源圖片 URL
# title / 中文商品名稱 / 英文商品名稱
# description / 中文描述 / 英文描述
# price / 售價 (HKD)
# originalPrice / 原價 (HKD) (optional)
# inStock / 庫存狀態
#
# The Sheet/CSV must be readable without an interactive Google login.
# All 114 known product IDs must have valid Sheet rows. Otherwise the complete
# catalog falls back to static PRODUCTS; partial Sheet/static mixing is blocked.
# The exact original Sheet URL is the default and can be overridden if needed.
# A configured CSV URL takes precedence over GOOGLE_SHEET_ID/GID.
# Option B: set the spreadsheet ID + numeric tab gid.
#
# Netlify → Site configuration → Environment variables, then redeploy once.
# Runtime reads are cached for 60 seconds by default; use 0 for every request.
# =============================================================================
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1zTZxk-cidcgcmGsM79jMQD72Fznmd7CfAQNS79pp6i0/export?format=csv
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_GID=0
# Product catalog requests always use live Google Sheet data (no cache).
# GOOGLE_SHEET_TIMEOUT_MS=5000

# Shop WhatsApp handle (display only)
SHOP_WHATSAPP_HANDLE=MofuHavenHK

# =============================================================================
# Stripe (required for card, wallets and hosted Checkout)
# Vercel → Project → Settings → Environment Variables → Production
# Then redeploy.
#
# Dashboard: https://dashboard.stripe.com/apikeys
# - STRIPE_PUBLISHABLE_KEY = pk_live_... (or pk_test_... for testing)
# - STRIPE_LIVE_SECRET_KEY = sk_live_... (or sk_test_... for testing)
# - STRIPE_SECRET_KEY      = legacy fallback (optional)
#
# Register every production / preview domain that may display wallet checkout:
# Stripe Dashboard → Settings → Payment methods → Payment method domains
# → add mofuhavenhk.com and the active *.vercel.app preview domain.
# Google Pay is rendered by Stripe Checkout when Dashboard, browser, device,
# country, currency and domain requirements are satisfied.
#
# The hosted Checkout route deliberately omits payment_method_types so Stripe
# can use Dashboard-enabled dynamic payment methods. It also sends
# wallet_options.link.display=never to remove Link from the hosted Express area;
# Apple Pay / Google Pay stay eligible in the standard payment method list.
# Stripe's hosted Checkout API has no confirmed per-session switch that hides
# the entire Express area while retaining Apple Pay / Google Pay in the list.
# If the Dashboard exposes a separate Checkout / Express Checkout toggle, turn
# that off there. Do not attempt to hide checkout.stripe.com with site CSS.
# If a custom Stripe Payment Method Configuration contains PayMe or an
# account-specific AlipayHK option, set its ID here. The app passes this same
# ID to Checkout Sessions and PaymentIntents; never send unknown `payme` or
# `alipayhk` enums from application code.
# The app explicitly excludes Stripe's `alipay` type (the domestic Alipay
# integration). Stripe's official support article currently says AlipayHK is
# not supported as the same `alipay` method, so do not label domestic Alipay
# as AlipayHK. Only keep AlipayHK enabled if Stripe shows a separately
# supported method/configuration for your account.
#
# Dashboard → Settings → Payment methods → Payment configurations:
# enable Google Pay, PayMe and any genuinely supported AlipayHK method;
# disable Mainland Alipay (`alipay`).
# =============================================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
# One-time guarded Stripe catalog sync from a public Google Sheet CSV.
# Use a deployment-only build variable: SYNC_STRIPE_ON_BUILD=1.
# STRIPE_SYNC_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<sheet-id>/export?format=csv&gid=<tab-gid>
# STRIPE_SYNC_BATCH=1 # valid values: 1, 2, 3
# Optional alias (also supported):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# CallMeBot auto order notify (both values are required; no credentials are stored in source)
# =============================================================================
# WHATSAPP_PHONE=852XXXXXXXX
# WHATSAPP_API_KEY=

# Optional: checkout "手動開啟店主 WhatsApp" backup
# NEXT_PUBLIC_WHATSAPP_NUMBER=852XXXXXXXX

# Optional: footer contact email (defaults to hello@mofuhavenhk.com)
# NEXT_PUBLIC_SHOP_EMAIL=hello@mofuhavenhk.com

# Optional: The Cat API key for breed photo helpers (basic rate limit works without it)
# https://thecatapi.com/
# NEXT_PUBLIC_CAT_API_KEY=
