# Copy this file to .env.local for local development, or configure the same
# variables in your hosting provider's dashboard (e.g. Vercel → Project →
# Settings → Environment Variables) for production.

# --- Automatic WhatsApp order notifications (server-side) ---
# When a customer places an order at /checkout, POST /api/notify-order
# automatically sends a "new order" WhatsApp message to the shop's own
# WhatsApp number/account (@MofuHavenHK). Configure ONE of the two providers
# below using the phone number / API credentials that belong to the
# @MofuHavenHK WhatsApp account that should actually receive new-order
# alerts — these are account-specific secrets that only the shop owner has,
# so they must be supplied here (or as secrets in your Cursor/Vercel
# dashboard) rather than guessed. If neither is configured, the route
# responds with { ok: false, error: "not_configured" } and the checkout
# page shows a friendly fallback message pointing customers at the manual
# "Order via WhatsApp" button — the order is never blocked.

# Optional: label included in the notification header (e.g. "@MofuHavenHK")
# so it's unambiguous which shop account an order belongs to. Defaults to
# "MofuHavenHK" if not set.
SHOP_WHATSAPP_HANDLE=MofuHavenHK

# Option A — CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Free, no business account needed. From the @MofuHavenHK WhatsApp number,
# add the CallMeBot number as a contact, send it the activation message it
# gives you, then set the @MofuHavenHK phone number + the API key it replies
# with:
CALLMEBOT_PHONE=85212345678
CALLMEBOT_APIKEY=123456

# Option B — Twilio WhatsApp API (https://www.twilio.com/docs/whatsapp)
# Tried first if fully configured; falls back to CallMeBot above on failure.
# TWILIO_WHATSAPP_TO must be the @MofuHavenHK WhatsApp number.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+85212345678

# Optional: website link included in the notification message.
# Defaults to the request's own origin if not set.
NEXT_PUBLIC_SITE_URL=https://mofuhavenhk.vercel.app

# --- Existing: customer-facing "Order via WhatsApp" button on /checkout ---
# The number the *customer's* WhatsApp chat opens with when they tap
# "Order via WhatsApp" themselves (separate from the shop notification above).
NEXT_PUBLIC_WHATSAPP_NUMBER=85212345678
