# Site
NEXT_PUBLIC_SITE_URL=https://mofuhavenhk.com

# Shop WhatsApp handle (display only)
SHOP_WHATSAPP_HANDLE=MofuHavenHK

# =============================================================================
# REQUIRED for auto order notify (CallMeBot — free)
# Set these two on Vercel → Project → Settings → Environment Variables
# (Production). Then Redeploy.
#
# Setup steps (once):
# 1) On the @MofuHavenHK WhatsApp, add the CallMeBot contact and activate:
#    https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 2) Paste the phone (digits + country code, no +) and the apikey CallMeBot
#    replies with into the two vars below.
# =============================================================================
WHATSAPP_PHONE=852XXXXXXXX
WHATSAPP_API_KEY=

# Optional: same digits for the checkout "手動開啟店主 WhatsApp" backup button
NEXT_PUBLIC_WHATSAPP_NUMBER=852XXXXXXXX

# Legacy aliases (optional — WHATSAPP_PHONE / WHATSAPP_API_KEY are preferred)
# CALLMEBOT_PHONE=
# CALLMEBOT_APIKEY=
