# Site
NEXT_PUBLIC_SITE_URL=https://mofuhavenhk.com

# Shop WhatsApp handle (display / docs). Delivery uses phone below.
SHOP_WHATSAPP_HANDLE=MofuHavenHK

# --- Preferred: CallMeBot (free WhatsApp text API) ---
# 1) Save the CallMeBot contact and authorize from the shop WhatsApp (@MofuHavenHK).
# 2) Put the shop WhatsApp number in international format (digits only, with country code).
# 3) Paste the apikey CallMeBot replies with.
# Docs: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Optional: Twilio WhatsApp ---
# If set, Twilio is tried first; CallMeBot is the fallback.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+852XXXXXXXX
