# Site
NEXT_PUBLIC_SITE_URL=https://mofuhavenhk.com

# Shop WhatsApp handle (display only)
SHOP_WHATSAPP_HANDLE=MofuHavenHK

# =============================================================================
# CallMeBot auto order notify
# Server defaults for @MofuHavenHK already ship in src/lib/notifyWhatsapp.ts
# so Production works out of the box. Override on Vercel if needed:
# =============================================================================
# WHATSAPP_PHONE=852XXXXXXXX
# WHATSAPP_API_KEY=

# Optional: checkout "手動開啟店主 WhatsApp" backup (defaults to shop number in code)
# NEXT_PUBLIC_WHATSAPP_NUMBER=852XXXXXXXX
