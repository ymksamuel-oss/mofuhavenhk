# Site
NEXT_PUBLIC_SITE_URL=https://mofuhavenhk.com

# Shop WhatsApp identity
# Handle is for display / docs. Delivery ALWAYS needs the phone behind @MofuHavenHK
# (WhatsApp usernames cannot be used by Cloud API / Twilio / wa.me).
SHOP_WHATSAPP_HANDLE=MofuHavenHK
SHOP_WHATSAPP_PHONE=852XXXXXXXX

# Public number used only by the optional customer "manual WhatsApp backup"
# button (wa.me). Must be the same digits as SHOP_WHATSAPP_PHONE.
NEXT_PUBLIC_WHATSAPP_NUMBER=852XXXXXXXX

# =============================================================================
# Server-side auto notify (required for "確認付款並通知店主")
# Configure AT LEAST ONE gateway below on Vercel Production.
# Place-order calls POST /api/notify-order — never opens wa.me for this path.
# =============================================================================

# --- Option A (simplest / free): CallMeBot ---
# From the @MofuHavenHK WhatsApp account:
# 1) Add CallMeBot contact and send the activation message
# 2) Paste the phone (digits, with country code) + apikey
# Docs: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=852XXXXXXXX
CALLMEBOT_APIKEY=

# --- Option B: Meta WhatsApp Cloud API ---
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_TO=852XXXXXXXX

# --- Option C: Twilio WhatsApp ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+852XXXXXXXX

# --- Option D: Green API ---
# GREEN_API_INSTANCE_ID=
# GREEN_API_TOKEN=
# GREEN_API_CHAT_ID=852XXXXXXXX@c.us
