# Site
NEXT_PUBLIC_SITE_URL=https://mofuhavenhk.com

# =============================================================================
# Google Sheet single-source product catalog fields (server-only, read-only)
#
# The parser scans the first 20 non-empty rows, so row 1 may be a title.
# Required field groups include:
# id / 商品 ID
# image / 本地圖片路徑 / 來源圖片 URL
# title / 中文商品名稱 / 英文商品名稱
# description / 中文描述 / 英文描述
# price / 售價 (HKD)
# originalPrice / 原價 (HKD) (optional)
# inStock / 庫存狀態
#
# The Sheet/CSV must be readable without an interactive Google login.
# All 114 known product IDs must have valid Sheet rows. Otherwise the complete
# catalog falls back to static PRODUCTS; partial Sheet/static mixing is blocked.
# The exact original Sheet URL is the default and can be overridden if needed.
# A configured CSV URL takes precedence over GOOGLE_SHEET_ID/GID.
# Option B: set the spreadsheet ID + numeric tab gid.
#
# Netlify → Site configuration → Environment variables, then redeploy once.
# Runtime reads are cached for 60 seconds by default; use 0 for every request.
# =============================================================================
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1zTZxk-cidcgcmGsM79jMQD72Fznmd7CfAQNS79pp6i0/export?format=csv
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_GID=0
# Product catalog requests always use live Google Sheet data (no cache).
# GOOGLE_SHEET_TIMEOUT_MS=5000

# Shop WhatsApp handle (display only)
SHOP_WHATSAPP_HANDLE=MofuHavenHK

# =============================================================================
# Stripe (required for real card + Apple Pay checkout)
# Vercel → Project → Settings → Environment Variables → Production
# Then Redeploy.
#
# Dashboard: https://dashboard.stripe.com/apikeys
# - STRIPE_PUBLISHABLE_KEY = pk_live_... (or pk_test_... for testing)
# - STRIPE_SECRET_KEY      = sk_live_... (or sk_test_...)
#
# Apple Pay: Stripe Dashboard → Settings → Payment methods → Apple Pay
# → Add domain mofuhavenhk.com (and *.vercel.app for previews if needed)
# Google Pay is disabled in checkout (Payment Request disableWallets).
#
# WeChat Pay + Alipay / AlipayHK (HKD):
# Stripe Dashboard → Settings → Payment methods → enable WeChat Pay & Alipay
# =============================================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# One-time guarded Stripe catalog sync from a public Google Sheet CSV.
# Use a deployment-only build variable: SYNC_STRIPE_ON_BUILD=1.
# STRIPE_SYNC_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<sheet-id>/export?format=csv&gid=<tab-gid>
# STRIPE_SYNC_BATCH=1 # valid values: 1, 2, 3
# Optional alias (also supported):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# CallMeBot auto order notify (both values are required; no credentials are stored in source)
# =============================================================================
# WHATSAPP_PHONE=852XXXXXXXX
# WHATSAPP_API_KEY=

# Optional: checkout "手動開啟店主 WhatsApp" backup
# NEXT_PUBLIC_WHATSAPP_NUMBER=852XXXXXXXX

# Optional: footer contact email (defaults to hello@mofuhavenhk.com)
# NEXT_PUBLIC_SHOP_EMAIL=hello@mofuhavenhk.com

# Optional: The Cat API key for breed photo helpers (basic rate limit works without it)
# https://thecatapi.com/
# NEXT_PUBLIC_CAT_API_KEY=
